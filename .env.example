# Copy to .env and adjust. Never commit .env.
FORGE_ENVIRONMENT=local
FORGE_LOG_LEVEL=INFO

# Which provider the LLM gateway uses: ollama | groq | gemini
FORGE_LLM_PROVIDER=ollama

# Ollama (reached through: ssh -N gpu)
FORGE_OLLAMA_BASE_URL=http://localhost:11434/v1
FORGE_OLLAMA_MODEL=qwen3.5:9b

# Cloud fallbacks (optional)
FORGE_GROQ_API_KEY=
FORGE_GROQ_MODEL=llama-3.3-70b-versatile
FORGE_GEMINI_API_KEY=
FORGE_GEMINI_MODEL=gemini-2.0-flash

# Networking
FORGE_REQUEST_TIMEOUT_S=300
